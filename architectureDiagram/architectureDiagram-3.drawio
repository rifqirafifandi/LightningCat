        <mxCell id="GVZiM5FyR8gvw6AnfC3z-49" value="Web tier networking (TODO: EDISON)&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Verify DNS name for ALB&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Create alias record in Route53 and map to ALB&#39;s DNS name&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Obtain SSL Cert&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Configure SSL termination on ALB&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Configure security groups for EC2s&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;App tier networking (TODO: EDISON)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Confirm private subnet components (DB tier still TBD)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Configure Network ACL for private subnet&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Configure route table for web &amp;lt;-&amp;gt; app communication&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Obtain private SSL certificate from ACM Private Cert Authority&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Internal ALB should only listen on 443&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Configure SSL termination on internal ALB&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Other (TODO:EDISON)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Public and Private subnet route tables&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;movab